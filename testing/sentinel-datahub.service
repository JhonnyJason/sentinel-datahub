[Unit]
Description=Tested sentinel-datahub service :-)

Requires=sentinel-datahub.socket
After=sentinel-datahub.socket

[Service]
User=services
Group=services

ExecStart=/usr/bin/node /opt/void/sentinel-datahub/service.js
WorkingDirectory=/srv/srvcs/sentinel-datahub/

Environment=SOCKETMODE=true
Restart=no

[Install]
WantedBy=multi-user.target
